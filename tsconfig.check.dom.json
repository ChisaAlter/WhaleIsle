{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/**/*",
    "mobile/web/**/*",
    "vendor/dsh-deepseek-tools/client/**/*",
    "vendor/dsh-project/client/**/*",
    "vendor/dsh-whale/client/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.bundle.js",
    "**/node_modules/**",
    "src/renderer/openui/**",
    "src/renderer/pet-live2d/ort/**",
    "src/renderer/pet-live2d/anime4k.js"
  ]
}
