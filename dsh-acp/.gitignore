# Keep this repository limited to the distributable plugin and its sources.
# Local desktop helpers, diagnostics, screenshots and account data stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/.github/
/.github/*
!/.github/workflows/
!/.github/dependabot.yml
!/.github/copilot-instructions.md
!/LICENSE
!/README.md
!/README.en.md
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/agent-picker.png
!/docs/screenshots/agent-account.png
!/THIRD_PARTY_NOTICES.md
!/package.json
!/cordis.patch.yml
!/lib/
!/client/
!/client-src/
!/tests/
!/tools/
/tools/*
!/tools/runtime-build/
!/tools/host-compat/
!/tools/build-client.mjs

node_modules/
artifacts/
*.tgz
*.log
.env
.env.*
