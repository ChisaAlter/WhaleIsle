{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      // 宿主运行时注入的依赖：使用仓库内受跟踪的稳定声明副本（types/deepseek-harness/）
      // 以及根依赖自带的 zod 类型，避免依赖 setup:harness 生成的 gitignored
      // 构建产物，保证本地已构建与 CI 未构建环境下 npm run typecheck 输出一致。
      // 未列出的宿主注入包（dsh-agent-team、dsh-client-* 等）保持未解析，进基线。
      "@deepseek-ai/cordis": ["./types/deepseek-harness/cordis/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["./types/deepseek-harness/dsh-tools/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["./types/deepseek-harness/dsh-llm/index.d.ts"],
      "@deepseek-ai/dsh-scope": ["./types/deepseek-harness/dsh-scope/index.d.ts"],
      "@deepseek-ai/dsh-brand": ["./types/deepseek-harness/dsh-brand/index.d.ts"],
      "@deepseek-ai/dsh-timeout": ["./types/deepseek-harness/dsh-timeout/index.d.ts"],
      "@deepseek-ai/dsh-typert-protocol": ["./types/deepseek-harness/dsh-typert-protocol/index.d.ts"],
      "@deepseek-ai/dsh-util-crypto": ["./types/deepseek-harness/dsh-util-crypto/index.d.ts"],
      "@deepseek-ai/dsh-util-values": ["./types/deepseek-harness/dsh-util-values/index.d.ts"],
      "@deepseek-ai/cosmokit": ["./types/deepseek-harness/cosmokit/index.d.ts"],
      "@deepseek-ai/schemastery": ["./types/deepseek-harness/schemastery/index.d.ts"],
      "zod": ["./node_modules/zod/index.d.ts"]
    }
  },
  "include": [
    "src/shared/**/*",
    "src/preload/**/*",
    "src/main/**/*",
    "src/main-launcher/**/*",
    "src/host/**/*",
    "src/launcher/**/*",
    "scripts/**/*",
    "vendor/dsh-deepseek-tools/**/*",
    "vendor/dsh-platform-session/**/*",
    "vendor/dsh-project/**/*",
    "vendor/dsh-shared/**/*",
    "vendor/dsh-task-control/**/*",
    "vendor/dsh-whale/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.bundle.js",
    "**/node_modules/**",
    "src/main/test-fixtures/**",
    "src/renderer/**",
    "vendor/*/client/**",
    "vendor/dsh-whale/src/client/**"
  ]
}
