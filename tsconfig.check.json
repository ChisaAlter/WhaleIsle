{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/shared/**/*",
    "src/preload/**/*",
    "src/main/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.bundle.js",
    "src/main/test-fixtures/**"
  ]
}
