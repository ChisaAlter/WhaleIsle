{
  "name": "dsh-pad",
  "version": "0.3.1",
  "description": "DeepSeek Harness 插件：悬浮面板坞，面板由 AI 在对话里生成并自由分区；支持本机/HTTP 数据源、AI 刷新、面板内 dsh.run 模型调用",
  "license": "MIT",
  "author": "ChisaAlter",
  "homepage": "https://github.com/ChisaAlter/dsh-pad#readme",
  "bugs": {
    "url": "https://github.com/ChisaAlter/dsh-pad/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChisaAlter/dsh-pad.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "panels",
    "widgets",
    "ai"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "node scripts/prepare.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
