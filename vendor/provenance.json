      "rebuild": {
        "inputs": [
          "plugin-src",
          "src",
          "package.json"
        ],
        "links": [
          "node_modules"
        ],
        "commands": [
          [
            "plugin-src/client/build.mjs"
          ],
          [
            "plugin-src/host/build.mjs"
          ]
        ],
        "outputs": [
          "lib/client.js",
          "lib/index.js"
        ]
      }
